# The read command in Linux shell scripting is a built-in command used to capture a line of input from standard input (like the keyboard) and store it into a variable

read [options] VARIABLE_NAME

#  If you run read without providing a variable name, Bash automatically stores the input in a built-in default variable named $REPLY

# With multiple variables: If you provide multiple variable names (e.g., read var1 var2), read will split the input line based on spaces; the first word goes to var1, the second to var2, and any remaining text is dumped into the final variable.

read var1
# 4
echo $var1
# 4

read var1 var2
# 45 21
echo $var1
# 45
echo $var2
# 21


# -p	Displays a prompt string before waiting for input.	
read -p "Enter your name: " user_name

# -s	Silent mode. Hides characters as they are typed (perfect for passwords).	
read -sp "Enter password: " user_pass


# -t	Sets a timeout in seconds. If the user doesn't hit enter, it stops waiting.	
read -t 5 -p "Hurry (5s limit): " quick_ans

# -a	Reads the input line split into an array instead of standard variables.	
read -a colors_array

#! /usr/bin/bash

read -p "Enter a number: " num
if [ "$num" -ge 0 ];
then echo "it is positive Number";
elif [ "$num" -lt 0 ];
then echo "it is negative Number";
fi

