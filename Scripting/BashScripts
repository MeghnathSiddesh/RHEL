# you can redirect the output of a command to a exisiting or new file
echo $HOME > home.txt
sh script2.sh > script
# the > will redirect only the useful output, it will not redirect the errors to the file
# it will delete the old output and add the new output

# append operator
sh script2.sh >> script
# this will only store the output and not the errors, but everytime you execute this command(>>) this will append the output to the script file and it will not delete old output


# to redirect output along with error use: 2>
sh script2.sh 2> script
# this will store the errors as well

