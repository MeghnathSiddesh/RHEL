# -q	Quiet mode	Suppresses output entirely. Used solely to check if a pattern exists via exit status.
# Use Case: Best used inside conditional if statements when you only care if something exists, but you don't want the text cluttering the terminal or log files.

#!/bin/bash
# Check if the user "admin" exists in the system passwd file
if grep -q "^admin:" /etc/passwd; then
    echo "Access granted: Admin user found."
else
    echo "Access denied: Account does not exist."
fi

# here grep will not throw the output to terminal in quiet mode, it will just return exit status 0 or 1


# -c	Count	Outputs just a number representing the matched lines; great for counting errors.
# it will output the no of lines which this pattern is having in the file or output

#!/bin/bash
# Count how many failed login attempts occurred
FAILED_COUNT=$(grep -c "Failed password" /var/log/auth.log)
if [ "$FAILED_COUNT" -gt 10 ]; then
    echo "Warning: High number of failed login attempts ($FAILED_COUNT)!"
fi


# -l	List filenames	Outputs only the names of files containing the match instead of the lines themselves.

# When you use grep normally across multiple files, it prints every single line that matches your pattern, prefixing it with the filename. However, when you add -l, grep stops reading a file the absolute moment it finds a single match, prints only the filename, and immediately skips to the next file.

# it prints only file name that pattern is having
# it is useful when searching across multiple files or directories

#!/bin/bash
# Find all script files that contain the word "TODO"
for file in $(grep -l "TODO" *.sh); do
    echo "Reminder: Please review tasks in $file"
done

#!/bin/bash

# Find all .txt files containing the word "malware"
# -l ensures we only get a list of filenames, not the matching text
for infected_file in $(grep -l "malware" /uploads/*.txt); do
    echo "Quarantining: $infected_file"
    mv "$infected_file" /quarantine/
done

# Open all bash scripts that contain the word "TODO"
nano $(grep -l "TODO" *.sh)


# Combining with xargs (The Professional Way)
# Using a for loop on command outputs can sometimes break if filenames contain spaces. Combining grep -l with xargs is a safer, faster industry standard.
# Find all configuration files containing "Port 22" and change it to "Port 2222" using sed
grep -l "Port 22" /etc/ssh/sshd_config.d/* | xargs sed -i 's/Port 22/Port 2222/g'

